---
// src/pages/posts/[slug].astro
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { resolveRefs } from '../../lib/references'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const tags = await resolveRefs('tags', post.data.tags)
---

<BaseLayout title={post.data.title} description={post.data.meta?.description}>
  <article class="pt-16 pb-16">
    <!-- Simplified vs. the original PostHero, which floats over a full-bleed
         image behind a transparent header -- same simplification as the
         highImpact hero earlier. -->
    <div class="relative text-white flex items-end min-h-[50vh]">
      {post.data.heroImage && (
        <img class="absolute inset-0 w-full h-full object-cover -z-10" src={post.data.heroImage} alt={post.data.heroImageAlt ?? ''} />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent -z-10"></div>

      <div class="container z-10 relative pb-8">
        <div class="max-w-[48rem]">
          {tags.length > 0 && (
            <div class="uppercase text-sm mb-6">
              {tags.map((c) => c.data.title).join(', ')}
            </div>
          )}
          <h1>{post.data.title}</h1>
          <div class="flex flex-col md:flex-row gap-4 md:gap-16">
            {post.data.authors && post.data.authors.length > 0 && (
              <div class="flex flex-col gap-1">
                <p class="text-sm">Author</p>
                <p>{post.data.authors.join(', ')}</p>
              </div>
            )}
            <div class="flex flex-col gap-1">
              <p class="text-sm">Date Published</p>
              <time datetime={post.data.publishedAt.toISOString()}>
                {post.data.publishedAt.toLocaleDateString()}
              </time>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container pt-8">
      <div class="max-w-[48rem] mx-auto">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>