---
// src/pages/events/index.astro
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import EventCard from '../../components/EventCard.astro'
import { isPastEvent, groupByMonth } from '../../lib/events'

const allEvents = await getCollection('events')
const upcoming = allEvents
  .filter((e) => !isPastEvent(e.data))
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
const past = allEvents
  .filter((e) => isPastEvent(e.data))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())

const upcomingByMonth = groupByMonth(upcoming)
const pastByMonth = groupByMonth(past)
---

<BaseLayout title="Events">
  <div class="page-header wave-bg">
    <div class="container">
      <h1 class="mb-0">Events</h1>
    </div>
  </div>

  <main class="section">
    <div class="container">
      <div class="tab-pills mb-10" role="tablist">
        <button type="button" data-events-tab="upcoming" aria-selected="true" class="tab-pill">Upcoming</button>
        <button type="button" data-events-tab="past" aria-selected="false" class="tab-pill">Past Events</button>
      </div>

      <div data-events-panel="upcoming" class="block">
        {upcoming.length === 0 ? (
          <p class="text-muted-foreground">No upcoming events at the moment.</p>
        ) : (
          <div class="flex flex-col gap-10 max-w-[56rem]">
            {upcomingByMonth.map(({ label, events }) => (
              <section>
                <h2 class="text-sm font-bold uppercase tracking-wide text-headings mb-5 pb-2 border-b-2 border-primary inline-block">{label}</h2>
                <div class="flex flex-col gap-5">
                  {events.map((event) => <EventCard event={event} />)}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>

      <div data-events-panel="past" class="hidden">
        {past.length === 0 ? (
          <p class="text-muted-foreground">No past events.</p>
        ) : (
          <div class="flex flex-col gap-10 max-w-[56rem]">
            {pastByMonth.map(({ label, events }) => (
              <section>
                <h2 class="text-sm font-bold uppercase tracking-wide text-headings mb-5 pb-2 border-b-2 border-primary inline-block">{label}</h2>
                <div class="flex flex-col gap-5">
                  {events.map((event) => <EventCard event={event} />)}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll('[data-events-tab]').forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-events-tab')

      document.querySelectorAll('[data-events-tab]').forEach((btn) => {
        btn.setAttribute('aria-selected', btn.getAttribute('data-events-tab') === target ? 'true' : 'false')
      })

      document.querySelectorAll('[data-events-panel]').forEach((panel) => {
        const match = panel.getAttribute('data-events-panel') === target
        panel.classList.toggle('hidden', !match)
        panel.classList.toggle('block', match)
      })
    })
  })
</script>