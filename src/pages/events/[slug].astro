---
// src/pages/events/[slug].astro
import { getCollection, getEntry, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { isPastEvent, formatEventDate } from '../../lib/events'

export async function getStaticPaths() {
  const events = await getCollection('events')
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }))
}

const { event } = Astro.props
const { Content } = await render(event)
const localOffice = event.data.localOffice ? await getEntry(event.data.localOffice) : undefined
const past = isPastEvent(event.data)
---

<BaseLayout title={event.data.title}>
  <main class="container my-16 max-w-3xl">
    <a href="/events" class="text-sm underline text-muted-foreground">← Events</a>

    {event.data.featuredImage && (
      <div class="mt-4 mb-6 rounded-md overflow-hidden">
        <img class="w-full" src={event.data.featuredImage} alt="" />
      </div>
    )}

    <h1 class="mb-6">{event.data.title}</h1>

    <p class="text-muted-foreground mb-1">
      {formatEventDate(event.data.startDate, {
        startTime: event.data.startTime,
        endDate: event.data.endDate,
        endTime: event.data.endTime,
        includeWeekday: true,
      })}
    </p>
    {event.data.location && <p class="text-muted-foreground mb-1">{event.data.location}</p>}
    {event.data.isOnline && <p class="text-muted-foreground mb-1">Online event</p>}

    <div class="flex gap-2 mt-2 mb-4">
      {event.data.cancelled && (
        <span class="inline-block text-xs font-medium uppercase tracking-wide text-red-600 border border-red-600 rounded-full px-3 py-1">
          Cancelled
        </span>
      )}
      {past && (
        <span class="inline-block text-xs font-medium uppercase tracking-wide text-muted-foreground border border-border rounded-full px-3 py-1">
          Past event
        </span>
      )}
    </div>

    {event.data.registrationUrl && !past && !event.data.cancelled && (
      <div class="mt-4 mb-6">
        <a
          href={event.data.registrationUrl}
          target="_blank"
          rel="noreferrer noopener"
          class="inline-block bg-primary text-primary-foreground rounded px-5 py-2 text-sm font-medium hover:bg-primary-hover transition-colors"
        >
          Register
        </a>
      </div>
    )}

    <div class="mt-6">
      <Content />
    </div>

    {localOffice && (
      <div class="mt-8 pt-6 border-t border-border">
        <p class="text-sm text-muted-foreground">
          Organised by{' '}
          <a href={`/local-offices/${localOffice.id}`} class="underline">{localOffice.data.name}</a>
        </p>
      </div>
    )}
  </main>
</BaseLayout>