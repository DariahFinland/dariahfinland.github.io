---
// src/components/blocks/UpcomingEvents.astro
//
// Restyled to match dariah.fi's real "Upcoming Events" section: a plain
// list (not a card grid) with a small month/day date badge to the left of
// each title, matching the live site's layout.

import { getCollection } from 'astro:content'
import { isPastEvent, formatEventDate } from '../../lib/events'

interface Props {
  heading?: string
  limit?: number
  viewAllLink?: string
}

const { heading = 'Upcoming Events', limit = 3, viewAllLink = '/events' } = Astro.props

const events = await getCollection('events')
const upcoming = events
  .filter((e) => !isPastEvent(e.data) && !e.data.cancelled)
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, limit)

const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()
const day = (d: Date) => d.getDate()
---

{upcoming.length > 0 && (
  <div class="section mt-20">
  <div class="container">
    <h2 class="mb-6">{heading}</h2>

    <ul class="flex flex-col divide-y divide-border">
      {upcoming.map((event) => (
        <li>
          <a href={`/events/${event.id}`} class="flex items-start gap-4 py-4 px-3 -mx-3 rounded-lg transition-colors hover:bg-muted group">
            <div class="w-12 flex-shrink-0 text-center">
              <p class="text-xs font-bold text-muted-foreground">{month(event.data.startDate)}</p>
              <p class="text-2xl font-bold text-headings leading-none">{day(event.data.startDate)}</p>
            </div>
            <div>
              <p class="text-xs text-muted-foreground mb-1">
                {formatEventDate(event.data.startDate, {
                  startTime: event.data.startTime,
                  endDate: event.data.endDate,
                  endTime: event.data.endTime,
                })}
              </p>
              <p class="font-semibold text-headings group-hover:text-primary transition-colors">
                {event.data.title}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>

    {viewAllLink && (
      <a href={viewAllLink} class="inline-block mt-4 text-sm font-semibold text-primary hover:text-primary-hover">
        View Calendar
      </a>
    )}
  </div>
  </div>
)}