---
// src/components/blocks/CallToAction.astro
import { md } from '../../lib/markdown'

interface Link {
  label: string
  url?: string
  newTab?: boolean
}

interface Props {
  richText?: string
  links?: Link[]
}

const { richText, links = [] } = Astro.props
---

<div class="container">
  <div class="bg-card rounded border-border border p-4 flex flex-col gap-8 md:flex-row md:justify-between md:items-center">
    <div class="max-w-[48rem] flex items-center">
      {richText && <div set:html={md(richText)} />}
    </div>
    <div class="flex flex-col gap-4">
      {links.map((link) => (
        <a
          href={link.url}
          target={link.newTab ? '_blank' : undefined}
          class="inline-block bg-primary text-primary-foreground px-6 py-3 rounded-md text-lg text-center hover:bg-primary-hover transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</div>
