---
// src/pages/contacts.astro
//
// This route never went through the export script because it was never a
// Payload "pages" entry in the first place -- the original site hardcodes
// it as its own route that just lists every local office. Same situation
// as /search: a page that exists in code, not in content.

import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

// `order` isn't a field on localOffices anymore (removed in the earlier
// alphabetical-sort cleanup) -- sort by name instead, same as
// local-offices/index.astro.
const offices = (await getCollection('localOffices')).sort((a, b) => a.data.name.localeCompare(b.data.name))
---

<BaseLayout title="Contacts">
  <div class="page-header wave-bg">
    <div class="container">
      <h1 class="mb-2">Contacts</h1>
      <p class="text-muted-foreground mb-0">Contact your local DARIAH-FI representative:</p>
    </div>
  </div>

  <main class="section">
    <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {offices.map((office) => (
        <div class="card-raised p-5">
          <p class="font-bold text-headings mb-3">{office.data.name}</p>

          {office.data.contacts && office.data.contacts.length > 0 ? (
            <div class="space-y-2">
              {office.data.contacts.map((contact) => (
                <div class="flex items-center gap-2">
                  {contact.photo ? (
                    <img src={contact.photo} alt="" class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 object-cover" />
                  ) : (
                    <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 bg-secondary"></div>
                  )}
                  <div class="text-sm">
                    {contact.url ? (
                      <a href={contact.url} target="_blank" rel="noreferrer noopener" class="underline">{contact.name}</a>
                    ) : (
                      <span>{contact.name}</span>
                    )}
                    {contact.note && <span class="text-muted-foreground"> {contact.note}</span>}
                    {contact.email && (
                      <div class="text-xs text-muted-foreground">
                        <a href={`mailto:${contact.email}`} class="underline">{contact.email}</a>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-muted-foreground">No contacts listed.</p>
          )}
        </div>
      ))}
    </div>
    </div>
  </main>
</BaseLayout>