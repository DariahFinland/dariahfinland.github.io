{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.21.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js"
    ]
  },
