---
// src/pages/[...slug].astro
//
// This one file handles every page in the `pages` collection. The [...slug]
// name means it's a "rest parameter" route -- it matches /, /about,
// /about/team, anything -- and getStaticPaths tells Astro exactly which
// URLs to generate, one per page document.

import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import HomeHero from '../components/HomeHero.astro'
import RenderBlocks from '../components/RenderBlocks.astro'

export async function getStaticPaths() {
  const pages = await getCollection('pages')

  return pages.map((page) => ({
    // slug "home" maps to the site root (params.slug left undefined);
    // everything else becomes /<slug>
    params: { slug: page.data.slug === 'home' ? undefined : page.data.slug },
    props: { page },
  }))
}

const { page } = Astro.props
const isHome = page.data.slug === 'home'

// Static, not CMS-editable -- only the homepage uses this background photo.
// Drop the file at public/images/home/hero-bg.jpg (replace the path below
// if you'd rather name/place it differently).
const HOME_HERO_BACKGROUND = '/images/hero-bg.png'
---

<BaseLayout title={page.data.title} description={page.data.meta?.description}>
  {isHome
    ? <HomeHero hero={page.data.hero} backgroundImage={HOME_HERO_BACKGROUND} />
    : <Hero hero={page.data.hero} />}
  <RenderBlocks layout={page.data.layout} />
</BaseLayout>