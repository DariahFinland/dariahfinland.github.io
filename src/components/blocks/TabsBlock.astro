---
// src/components/blocks/TabsBlock.astro
//
// Real click-based tab switching now (a small client-side <script> at the
// bottom handles it -- no framework needed for something this simple).
//
// developedBy/collaborators on tools, and the affiliated-group/tool
// descriptions, are handled a bit differently than other blocks:
//   - developedBy/collaborators are reference() fields -- resolved via
//     getEntry() to get each local office's actual name.
//   - descriptions live in the Markdown BODY of affiliated-groups/tools
//     files (not a frontmatter string), so each one needs its own
//     render() call to get a <Content /> component, same as the detail
//     pages do.

import { getCollection, getEntry, render } from 'astro:content'
import { md } from '../../lib/markdown'

interface Tab {
  label: string
  listType?: 'none' | 'affiliatedGroups' | 'tools'
  richText?: string
}

interface Props {
  tabs?: Tab[]
}

const { tabs = [] } = Astro.props

const needsGroups = tabs.some((t) => t.listType === 'affiliatedGroups')
const needsTools = tabs.some((t) => t.listType === 'tools')

const affiliatedGroups = needsGroups
  ? await Promise.all(
      (await getCollection('affiliatedGroups')).sort((a, b) => a.data.name.localeCompare(b.data.name)).map(async (g) => ({
        group: g,
        Content: (await render(g)).Content,
      })),
    )
  : []

const tools = needsTools
  ? await Promise.all(
      (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name)).map(async (t) => {
        const localOffice = t.data.localOffice ? await getEntry(t.data.localOffice) : undefined
        const collaborators = t.data.collaborators
          ? (await Promise.all(t.data.collaborators.map((ref) => getEntry(ref)))).filter((o) => o !== undefined)
          : []
        return { tool: t, Content: (await render(t)).Content, localOffice, collaborators }
      }),
    )
  : []
---

<div class="container my-8">
  <div class="flex border-b border-border mb-6 gap-1">
    {tabs.map((tab, i) => (
      <button
        type="button"
        data-tab-button={i}
        class={
          i === 0
            ? 'px-4 py-2 text-sm font-medium transition-colors rounded-t-md border border-b-background border-border bg-background text-foreground -mb-px'
            : 'px-4 py-2 text-sm font-medium transition-colors rounded-t-md text-muted-foreground hover:text-foreground'
        }
      >
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, i) => (
    <div data-tab-panel={i} class={i === 0 ? 'block' : 'hidden'}>
      {tab.richText && (!tab.listType || tab.listType === 'none') && (
        <div set:html={md(tab.richText)} />
      )}

      {tab.listType === 'affiliatedGroups' && (
        <div class="space-y-4 mt-4">
          {affiliatedGroups.map(({ group, Content }) => (
            <div class="border rounded-lg p-4 flex gap-4">
              {group.data.logo && (
                <div class="w-16 h-16 flex-shrink-0">
                  <img src={group.data.logo} alt="" class="w-full h-full object-contain" />
                </div>
              )}
              <div class="flex-1">
                <a href={group.data.externalUrl} target="_blank" rel="noreferrer noopener" class="font-semibold underline">
                  {group.data.name}
                </a>

                {group.data.expertise && group.data.expertise.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-2 mb-2">
                    {group.data.expertise.map((tag) => (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground">{tag}</span>
                    ))}
                  </div>
                )}

                <div class="text-sm text-muted-foreground mt-1 mb-2">
                  <Content />
                </div>

                {group.data.contactName && (
                  <p class="text-sm mt-2">
                    Contact:{' '}
                    {group.data.contactUrl ? (
                      <a href={group.data.contactUrl} target="_blank" rel="noreferrer noopener" class="underline">
                        {group.data.contactName}
                      </a>
                    ) : (
                      group.data.contactName
                    )}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      {tab.listType === 'tools' && (
        <div class="space-y-4 mt-4">
          {tools.map(({ tool, Content, localOffice, collaborators }) => (
            <div class="border rounded-lg p-4">
              <p class="font-semibold mb-2">{tool.data.name}</p>

              {tool.data.accessLinks && tool.data.accessLinks.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-2">
                  {tool.data.accessLinks.map((link) => (
                    <a href={link.url} target="_blank" rel="noreferrer noopener" class="text-sm underline">
                      {link.label ?? link.url}
                    </a>
                  ))}
                </div>
              )}

              {tool.data.tutorialUrl && (
                <p class="text-sm mb-2">
                  <a href={tool.data.tutorialUrl} target="_blank" rel="noreferrer noopener" class="underline">
                    Tutorial / Demo
                  </a>
                </p>
              )}

              <div class="text-sm text-muted-foreground mb-2">
                <Content />
              </div>

              {tool.data.contacts && tool.data.contacts.length > 0 && (
                <p class="text-sm text-muted-foreground mb-2">
                  Contact:{' '}
                  {tool.data.contacts.map((c, idx) => (
                    <>
                      {c.url ? (
                        <a href={c.url} target="_blank" rel="noreferrer noopener" class="underline">{c.name}</a>
                      ) : (
                        c.name
                      )}
                      {idx < tool.data.contacts!.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
              )}

              {(localOffice || collaborators.length > 0) && (
                <p class="text-xs text-muted-foreground">
                  {localOffice && `Developed by: ${localOffice.data.name}`}
                  {collaborators.length > 0 ? `${localOffice ? ' · with ' : 'With '}${collaborators.map((o) => o.data.name).join(', ')}` : ''}
                </p>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<script>
  // Vanilla-JS tab switching, scoped per tabs block so multiple TabsBlocks
  // on the same page don't interfere with each other.
  document.querySelectorAll('[data-tab-button]').forEach((button) => {
    button.addEventListener('click', () => {
      const wrapper = button.closest('.container')
      if (!wrapper) return
      const index = button.getAttribute('data-tab-button')

      wrapper.querySelectorAll('[data-tab-button]').forEach((btn) => {
        const active = btn === button
        btn.classList.toggle('border', active)
        btn.classList.toggle('border-b-background', active)
        btn.classList.toggle('border-border', active)
        btn.classList.toggle('bg-background', active)
        btn.classList.toggle('text-foreground', active)
        btn.classList.toggle('-mb-px', active)
        btn.classList.toggle('text-muted-foreground', !active)
        btn.classList.toggle('hover:text-foreground', !active)
      })

      wrapper.querySelectorAll('[data-tab-panel]').forEach((panel) => {
        const match = panel.getAttribute('data-tab-panel') === index
        panel.classList.toggle('hidden', !match)
        panel.classList.toggle('block', match)
      })
    })
  })
</script>