    "marked": "^18.0.9",
    "tailwindcss": "^4.3.3",
    "tinacms": "^3.12.1"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "js-yaml": "^5.3.0",
