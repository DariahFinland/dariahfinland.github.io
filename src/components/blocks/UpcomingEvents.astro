---
// src/components/blocks/UpcomingEvents.astro

import { getCollection } from 'astro:content'

interface Props {
  heading?: string
  limit?: number
  viewAllLink?: string
}

const { heading = 'Upcoming Events', limit = 3, viewAllLink = '/events' } = Astro.props

const events = await getCollection('events')
const upcoming = events
  .filter((e) => e.data.status === 'upcoming')
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, limit)
---

{upcoming.length > 0 && (
  <div class="container my-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-semibold">{heading}</h2>
      {viewAllLink && <a href={viewAllLink} class="text-sm underline">View all events</a>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {upcoming.map((event) => (
        <a href={`/events/${event.id}`} class="block border rounded-lg p-4 hover:bg-muted transition-colors" style="text-decoration: none;">
          <p class="text-sm text-muted-foreground mb-1">{event.data.startDate.toLocaleDateString()}</p>
          <p class="font-semibold">{event.data.title}</p>
          {event.data.location && <p class="text-sm text-muted-foreground mt-1">{event.data.location}</p>}
        </a>
      ))}
    </div>
  </div>
)}
