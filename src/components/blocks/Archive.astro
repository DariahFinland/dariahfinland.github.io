---
// src/components/blocks/Archive.astro
//
// Card layout ported from the original CollectionArchive/Card components.
// One extra step vs. before: `categories` on a post is a reference() field
// (an { id, collection } object, not a title), so we resolve each one via
// getEntry() to get its actual display title.

import { getCollection, getEntry } from 'astro:content'
import { md } from '../../lib/markdown'

interface Ref {
  id: string
  collection: string
}

interface Props {
  introRichText?: string
  populateBy?: 'collection' | 'selection'
  categories?: Ref[]
  limit?: number
  selectedDocs?: Ref[]
}

const {
  introRichText,
  populateBy = 'collection',
  categories = [],
  limit = 10,
  selectedDocs = [],
} = Astro.props

let posts
if (populateBy === 'selection' && selectedDocs.length > 0) {
  const entries = await Promise.all(selectedDocs.map((ref) => getEntry(ref)))
  posts = entries.filter((p) => p !== undefined)
} else {
  posts = await getCollection('posts')
  if (categories.length > 0) {
    const wanted = new Set(categories.map((c) => c.id))
    posts = posts.filter((p) => p.data.categories?.some((c) => wanted.has(c.id)))
  }
  posts = posts
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
    .slice(0, limit)
}

// Resolve each post's category references into titles for display.
const cards = await Promise.all(
  posts.map(async (post) => {
    const cats = post.data.categories
      ? await Promise.all(post.data.categories.map((c) => getEntry(c)))
      : []
    return {
      post,
      categoryTitles: cats.filter((c) => c !== undefined).map((c) => c.data.title),
    }
  }),
)
---

<div class="my-16">
  {introRichText && (
    <div class="container mb-8">
      <div class="max-w-[48rem]" set:html={md(introRichText)} />
    </div>
  )}

  <div class="container">
    <div class="grid grid-cols-4 sm:grid-cols-8 lg:grid-cols-12 gap-y-4 gap-x-4 lg:gap-y-8 lg:gap-x-8">
      {cards.map(({ post, categoryTitles }) => (
        <div class="col-span-4">
          <a
            href={`/posts/${post.id}`}
            class="block h-full border border-border rounded-lg overflow-hidden bg-card hover:cursor-pointer"
            style="text-decoration: none;"
          >
            {post.data?.heroImage && <img class="w-full" src={post.data.heroImage} alt="" />}
            <div class="p-4">
              {categoryTitles.length > 0 && (
                <div class="uppercase text-sm mb-4">{categoryTitles.join(', ')}</div>
              )}
              <h3 class="text-lg font-semibold">{post.data.title}</h3>
              {post.data.meta?.description && <p class="mt-2">{post.data.meta.description}</p>}
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</div>
