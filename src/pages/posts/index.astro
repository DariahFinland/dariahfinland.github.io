---
// src/pages/posts/index.astro
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { resolveRefs } from '../../lib/references'

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
)

// Resolve each post's category references into titles for the card labels
const cards = await Promise.all(
  posts.map(async (post) => {
    const cats = await resolveRefs('tags', post.data.tags)
    return { post, categoryTitles: cats.map((c) => c.data.title) }
  }),
)
---

<BaseLayout title="News and Blogs">
  <div class="page-header wave-bg">
    <div class="container">
      <h1 class="mb-0">News and Blogs</h1>
    </div>
  </div>

  <main class="section">
    <div class="container">
      <div class="grid grid-cols-4 sm:grid-cols-8 lg:grid-cols-12 gap-y-5 gap-x-4 lg:gap-y-8 lg:gap-x-8">
        {cards.map(({ post, categoryTitles }) => (
          <div class="col-span-4">
            <a
              href={`/posts/${post.id}`}
              class="card-raised block h-full overflow-hidden"
            >
              {post.data.meta?.image ? (
                <img class="w-full aspect-[16/10] object-cover" src={post.data.meta.image} alt="" />
              ) : (
                <img
                  class="w-full aspect-[16/10] object-cover"
                  src="public/images/placeholder.png"
                  alt=""
                />
              )}
              <div class="p-5">
                <h3 class="text-lg font-semibold text-headings">{post.data.title}</h3>
                {post.data.meta?.description && <p class="mt-2 text-sm text-muted-foreground">{post.data.meta.description}</p>}
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>