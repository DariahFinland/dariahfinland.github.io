---
// src/components/HomeLinkCards.astro
//
// The homepage's row of 3 image-button cards (Training & Teaching / Local
// Offices / Resources), matching dariah.fi's real homepage. Static and
// hardcoded on purpose -- it's only ever used on the index page, so it
// doesn't need to be a CMS-editable block. To change the labels, links, or
// photos, just edit the `cards` array below.
//
// Drop the three photos in public/images/home/ (any reasonably wide photo
// works, ~680x224px like the real site's is a good aspect ratio) and point
// `image` at them -- e.g. /images/home/training.jpg.

const cards = [
  {
    label: 'Training & Teaching',
    url: '/training-and-teaching',
    image: '/images/home/button_placeholder.png',
  },
  {
    label: 'Local Offices',
    url: '/local-offices',
    image: '/images/home/button_placeholder.png',
  },
  {
    label: 'Resources',
    url: '/resources',
    image: '/images/home/button_placeholder.png',
  },
]
---

<div class="container">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    {cards.map((card) => (
      <a href={card.url} class="group relative block h-40 rounded-xl overflow-hidden shadow-sm">
        <img
          src={card.image}
          alt=""
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-headings/80 via-headings/20 to-transparent"></div>
        <div class="absolute inset-0 flex items-center justify-between gap-3 p-5">
          <span class="text-white font-bold text-lg leading-tight">{card.label}</span>
          <svg
            class="flex-shrink-0 text-white transition-transform duration-300 group-hover:translate-x-1"
            width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>