---
// src/components/blocks/Archive.astro
//
// In Payload this queried Postgres live. Here, getCollection('posts') reads
// all post files at build time instead. `tags`/`selectedDocs` are
// plain strings now (see src/lib/references.ts), not astro:content
// reference() -- resolved/compared by hand below.

import { getCollection, getEntry } from 'astro:content'
import { md } from '../../lib/markdown'
import { resolveRefs, slugFromRef } from '../../lib/references'

interface Props {
  introRichText?: string
  populateBy?: 'collection' | 'selection'
  tags?: string[]
  limit?: number
  selectedDocs?: string[]
}

const {
  introRichText,
  populateBy = 'collection',
  tags = [],
  limit = 10,
  selectedDocs = [],
} = Astro.props

let posts
if (populateBy === 'selection' && selectedDocs.length > 0) {
  posts = await resolveRefs('posts', selectedDocs)
} else {
  posts = await getCollection('posts')
  if (tags.length > 0) {
    const wantedSlugs = new Set(tags.map((c) => slugFromRef(c)))
    posts = posts.filter((p) => p.data.tags?.some((c) => wantedSlugs.has(slugFromRef(c))))
  }
  posts = posts
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
    .slice(0, limit)
}

// Resolve each post's tag references into titles for display.
const cards = await Promise.all(
  posts.map(async (post) => {
    const cats = post.data.tags ? await resolveRefs('tags', post.data.tags) : []
    return {
      post,
      categoryTitles: cats.map((c) => c.data.title),
    }
  }),
)
---

<div class="section">
  {introRichText && (
    <div class="container mb-8">
      <div class="max-w-[48rem] rich-text" set:html={md(introRichText)} />
    </div>
  )}

  <div class="container">
    <div class="flex flex-col divide-y divide-border">
      {cards.map(({ post, categoryTitles }) => (
        <a
          href={`/posts/${post.id}`}
          class="flex items-start gap-5 py-6 px-3 -mx-3 rounded-lg transition-colors hover:bg-muted group"
        >
          {post.data.meta?.image ? (
            <img
              class="w-28 h-20 flex-shrink-0 object-cover rounded"
              src={post.data.meta.image}
              alt=""
            />
          ) : (
             <img
              class="w-28 h-20 flex-shrink-0 object-cover rounded"
              src="public/images/placeholder.png"
              alt=""
            />
          )}
          <div>
            <h3 class="text-lg font-semibold text-headings group-hover:text-primary transition-colors mb-1">
              {post.data.title}
            </h3>
            {post.data.meta?.description && (
              <p class="text-sm text-muted-foreground">
                {post.data.meta.description}{' '}
                <span class="text-primary font-semibold whitespace-nowrap">Read more</span>
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</div>