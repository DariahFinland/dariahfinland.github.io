---
// src/components/blocks/CallToAction.astro
import { md } from '../../lib/markdown'

interface Link {
  label: string
  url?: string
  newTab?: boolean
}

interface Props {
  richText?: string
  links?: Link[]
}

const { richText, links = [] } = Astro.props
---

<div class="section">
  <div class="container">
    <div class="bg-card rounded-xl border border-border shadow-sm p-6 md:p-8 flex flex-col gap-8 md:flex-row md:justify-between md:items-center">
      <div class="max-w-[48rem] flex items-center [&_h2]:mb-2 [&_h3]:mb-2 [&_p]:text-muted-foreground">
        {richText && <div class="rich-text" set:html={md(richText)} />}
      </div>
      <div class="flex flex-col gap-4 flex-shrink-0">
        {links.map((link) => (
          <a
            href={link.url}
            target={link.newTab ? '_blank' : undefined}
            class="inline-block bg-primary text-primary-foreground px-6 py-3 rounded-full font-semibold text-center hover:bg-primary-hover transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>