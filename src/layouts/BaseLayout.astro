---
// src/layouts/BaseLayout.astro
//
// Every page on the site wraps itself in this layout. It just sets up the
// <head> and puts Header/Footer around whatever content the page passes in.

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

// Pages using this layout can pass in a title/description for SEO.
interface Props {
  title: string
  description?: string
  image?: string // path or absolute URL, used for the social link preview
}

const { title, description, image } = Astro.props

// Open Graph / Twitter tags: what Facebook, LinkedIn, Bluesky, Mastodon etc.
// show as the link preview card when a page is shared (for example by the
// Buffer integration in scripts/share-to-buffer.mjs).
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url)
const previewImage = new URL(image ?? '/images/placeholder.png', Astro.site ?? Astro.url)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · DARIAH-FI</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:site_name" content="DARIAH-FI" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />

    {/* GoatCounter analytics -- production only, so local dev testing
        doesn't pollute the traffic numbers. */}
    {import.meta.env.PROD && (
      <script
        data-goatcounter="https://dariahfinland.goatcounter.com/count"
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <Header />

    <!-- <slot /> is where the page's own content gets inserted -->
    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>