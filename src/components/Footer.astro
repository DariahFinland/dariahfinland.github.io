---
// src/components/Footer.astro
//
// Same idea as Header.astro, just reading the "footer" entry instead.
// Social links (Bluesky/YouTube) are detected by domain and rendered as
// icons, separate from the plain text nav links -- ported directly from
// the original Footer/Component.tsx.

import { getEntry } from 'astro:content'

const footer = await getEntry('globals', 'footer')
const navItems = footer?.data.navItems ?? []

const socialDomains: Record<string, string> = {
  'bsky.app': 'bluesky',
  'youtube.com': 'youtube',
}

function getSocialIcon(url?: string): string | null {
  if (!url) return null
  for (const [domain, icon] of Object.entries(socialDomains)) {
    if (url.includes(domain)) return icon
  }
  return null
}

const textLinks = navItems.filter((item) => !getSocialIcon(item.url))
const socialLinks = navItems.filter((item) => getSocialIcon(item.url))
---

<footer class="mt-auto border-t border-border bg-black text-white">
  <div class="container py-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <a href="/" class="flex items-center flex-shrink-0">
      <img alt="Dariah Logo" width="160" height="40" loading="eager" fetchpriority="high" decoding="async" class="h-auto w-28 md:w-40" src="/dariah_logo.svg">
    </a>

    <nav class="flex flex-wrap gap-x-6 gap-y-2 items-center text-sm">
      <p>&copy; {new Date().getFullYear()} DARIAH-FI</p>
      {textLinks.map((item) => (
        <a
          href={item.url}
          target={item.newTab ? '_blank' : undefined}
          class="text-foreground hover:text-primary transition-colors text-sm whitespace-nowrap"
        >
          {item.label}
        </a>
      ))}
    </nav>

    {socialLinks.length > 0 && (
      <div class="flex items-center gap-4 flex-shrink-0">
        {socialLinks.map((item) => {
          const icon = getSocialIcon(item.url)
          return (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer noopener"
              class="text-foreground hover:text-primary transition-colors text-sm"
              aria-label={item.label ?? item.url}
            >
              {icon === 'bluesky' && (
                <svg viewBox="0 0 24 20" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C3.045 1.193 1.218 1.53.964 3.478c-.276 2.1-.23 4.306 1.395 5.373 1.744 1.14 3.474 1.38 3.474 1.38s-3.35.52-4.297 3.2c-1.022 2.864 1.716 5.57 5.463 3.95C9.483 15.842 11.038 13.62 12 10.8Zm0 0c1.087-2.114 4.046-6.053 6.798-7.995 2.157-1.612 3.984-1.274 4.238.674.276 2.1.23 4.306-1.395 5.373-1.744 1.14-3.474 1.38-3.474 1.38s3.35.52 4.297 3.2c1.022 2.864-1.716 5.57-5.463 3.95C14.517 15.842 12.962 13.62 12 10.8Z" />
                </svg>
              )}
              {icon === 'youtube' && (
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              )}
            </a>
          )
        })}
      </div>
    )}
  </div>
</footer>