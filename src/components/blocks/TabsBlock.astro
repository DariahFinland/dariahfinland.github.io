---
// src/components/blocks/TabsBlock.astro
//
// Real click-based tab switching now (a small client-side <script> at the
// bottom handles it -- no framework needed for something this simple).
// Tabs render as a segmented pill control (.tab-pills/.tab-pill in
// global.css) instead of the old border/underline hack, so the active tab
// is unmistakable at a glance. List items are raised cards
// (.card-raised) in a grid instead of a thin bordered list.
//
// developedBy/collaborators on tools, and the affiliated-group/tool
// descriptions, are handled a bit differently than other blocks:
//   - localOffice/collaborators are plain strings now (see
//     src/lib/references.ts), resolved via resolveRef()/resolveRefs()
//     instead of astro:content's reference() type.
//   - descriptions live in the Markdown BODY of affiliated-groups/tools
//     files (not a frontmatter string), so each one needs its own
//     render() call to get a <Content /> component, same as the detail
//     pages do.

import { getCollection, render } from 'astro:content'
import { md } from '../../lib/markdown'
import { resolveRef, resolveRefs } from '../../lib/references'

interface Tab {
  label: string
  listType?: 'none' | 'affiliatedGroups' | 'tools'
  richText?: string
}

interface Props {
  tabs?: Tab[]
}

const { tabs = [] } = Astro.props

const needsGroups = tabs.some((t) => t.listType === 'affiliatedGroups')
const needsTools = tabs.some((t) => t.listType === 'tools')

const affiliatedGroups = needsGroups
  ? await Promise.all(
      (await getCollection('affiliatedGroups')).sort((a, b) => a.data.name.localeCompare(b.data.name)).map(async (g) => ({
        group: g,
        Content: (await render(g)).Content,
        expertiseTags: await resolveRefs('tags', g.data.expertise),
      })),
    )
  : []

const tools = needsTools
  ? await Promise.all(
      (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name)).map(async (t) => {
        const localOffice = await resolveRef('localOffices', t.data.localOffice)
        const collaborators = await resolveRefs('localOffices', t.data.collaborators)
        return { tool: t, Content: (await render(t)).Content, localOffice, collaborators }
      }),
    )
  : []
---

<div class="section">
  <div class="container">
    <div class="tab-pills mb-10" role="tablist">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-tab-button={i}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="tab-pill"
        >
          {tab.label}
        </button>
      ))}
    </div>

    {tabs.map((tab, i) => (
      <div data-tab-panel={i} class={i === 0 ? 'block' : 'hidden'}>
        {tab.richText && (!tab.listType || tab.listType === 'none') && (
          <div class="rich-text" set:html={md(tab.richText)} />
        )}

        {tab.listType === 'affiliatedGroups' && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {affiliatedGroups.map(({ group, Content, expertiseTags }) => (
              <div class="card-raised p-5 flex gap-4">
                {group.data.logo && (
                  <div class="w-14 h-14 flex-shrink-0">
                    <img src={group.data.logo} alt="" class="w-full h-full object-contain" />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <a href={group.data.externalUrl} target="_blank" rel="noreferrer noopener" class="font-bold text-headings hover:text-primary transition-colors">
                    {group.data.name}
                  </a>

                  {expertiseTags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-2 mb-2">
                      {expertiseTags.map((tag) => (
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-muted text-muted-foreground">{tag.data.title}</span>
                      ))}
                    </div>
                  )}

                  <div class="text-sm text-muted-foreground mt-1 mb-2 rich-text">
                    <Content />
                  </div>

                  {group.data.contactName && (
                    <p class="text-sm mt-2">
                      Contact:{' '}
                      {group.data.contactUrl ? (
                        <a href={group.data.contactUrl} target="_blank" rel="noreferrer noopener" class="underline">
                          {group.data.contactName}
                        </a>
                      ) : (
                        group.data.contactName
                      )}
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}

        {tab.listType === 'tools' && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {tools.map(({ tool, Content, localOffice, collaborators }) => (
              <div class="card-raised p-5">
                <p class="font-bold text-headings mb-2">{tool.data.name}</p>

                {tool.data.accessLinks && tool.data.accessLinks.length > 0 && (
                  <div class="flex flex-wrap gap-x-3 gap-y-1 mb-2">
                    {tool.data.accessLinks.map((link) => (
                      <a href={link.url} target="_blank" rel="noreferrer noopener" class="text-sm font-semibold underline">
                        {link.label ?? link.url}
                      </a>
                    ))}
                  </div>
                )}

                {tool.data.tutorialUrl && (
                  <p class="text-sm mb-2">
                    <a href={tool.data.tutorialUrl} target="_blank" rel="noreferrer noopener" class="underline font-semibold">
                      Tutorial / Demo
                    </a>
                  </p>
                )}

                <div class="text-sm text-muted-foreground mb-2 rich-text">
                  <Content />
                </div>

                {tool.data.contacts && tool.data.contacts.length > 0 && (
                  <p class="text-sm text-muted-foreground mb-2">
                    Contact:{' '}
                    {tool.data.contacts.map((c, idx) => (
                      <>
                        {c.url ? (
                          <a href={c.url} target="_blank" rel="noreferrer noopener" class="underline">{c.name}</a>
                        ) : (
                          c.name
                        )}
                        {idx < tool.data.contacts!.length - 1 ? ', ' : ''}
                      </>
                    ))}
                  </p>
                )}

                {(localOffice || collaborators.length > 0) && (
                  <p class="text-xs text-muted-foreground pt-2 border-t border-border">
                    {localOffice && `Developed by: ${localOffice.data.name}`}
                    {collaborators.length > 0 ? `${localOffice ? ' · with ' : 'With '}${collaborators.map((o) => o.data.name).join(', ')}` : ''}
                  </p>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<script>
  // Vanilla-JS tab switching, scoped per tabs block so multiple TabsBlocks
  // on the same page don't interfere with each other. Active state is
  // just the aria-selected attribute -- .tab-pill[aria-selected="true"]
  // in global.css handles the look.
  document.querySelectorAll('[data-tab-button]').forEach((button) => {
    button.addEventListener('click', () => {
      const wrapper = button.closest('.container')
      if (!wrapper) return
      const index = button.getAttribute('data-tab-button')

      wrapper.querySelectorAll('[data-tab-button]').forEach((btn) => {
        btn.setAttribute('aria-selected', btn === button ? 'true' : 'false')
      })

      wrapper.querySelectorAll('[data-tab-panel]').forEach((panel) => {
        const match = panel.getAttribute('data-tab-panel') === index
        panel.classList.toggle('hidden', !match)
        panel.classList.toggle('block', match)
      })
    })
  })
</script>