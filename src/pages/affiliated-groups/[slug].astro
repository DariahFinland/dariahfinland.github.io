---
// src/pages/affiliated-groups/[slug].astro
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import TagPill from '../../components/TagPill.astro'
import { resolveRefs } from '../../lib/references'

export async function getStaticPaths() {
  const groups = await getCollection('affiliatedGroups')
  return groups.map((group) => ({
    params: { slug: group.id },
    props: { group },
  }))
}

const { group } = Astro.props
const { Content } = await render(group)
const expertiseTags = await resolveRefs('tags', group.data.expertise)
---

<BaseLayout title={group.data.name}>
  <article>
    <h1>{group.data.name}</h1>
    {group.data.logo && <img src={group.data.logo} alt="" />}
    <Content />

    {expertiseTags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {expertiseTags.map((tag) => <TagPill tag={tag} />)}
      </div>
    )}
    {group.data.externalUrl && <a href={group.data.externalUrl}>Website</a>}
  </article>
</BaseLayout>