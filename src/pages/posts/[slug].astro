---
// src/pages/posts/[slug].astro
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import TagPill from '../../components/TagPill.astro'
import { resolveRefs } from '../../lib/references'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const tags = await resolveRefs('tags', post.data.tags)
---

<BaseLayout title={post.data.title} description={post.data.meta?.description}>
  <article class="pb-16">
    <!-- Image on its own (cropped/centered to a fixed banner ratio), with the
         title block underneath instead of overlaid on the photo. -->
    {post.data.heroImage && (
      <div class="container pt-8">
        <img
          class="max-w-[48rem] mx-auto w-full aspect-[16/9] object-cover object-center rounded-xl border border-border"
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
        />
      </div>
    )}

    <header class="container pt-8 pb-8 border-b border-border">
      <div class="max-w-[48rem] mx-auto">
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mb-3">
            {tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        )}
        <h1>{post.data.title}</h1>
        <div class="flex flex-col md:flex-row gap-4 md:gap-16 text-muted-foreground">
          {post.data.authors && post.data.authors.length > 0 && (
            <div class="flex flex-col gap-1">
              <p class="text-sm">Author</p>
              <p class="text-foreground">{post.data.authors.join(', ')}</p>
            </div>
          )}
          <div class="flex flex-col gap-1">
            <p class="text-sm">Date Published</p>
            <time class="text-foreground" datetime={post.data.publishedAt.toISOString()}>
              {post.data.publishedAt.toLocaleDateString('en-GB', { timeZone: 'UTC' })}
            </time>
          </div>
        </div>
      </div>
    </header>

    <div class="container pt-8">
      <div class="max-w-[48rem] mx-auto rich-text post-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Images inside the post text: never wider than the text column, with
     space above and below, and (on wider screens) inset from both sides. */
  .post-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 0.75rem;
  }
  @media (min-width: 640px) {
    .post-body :global(img) {
      max-width: calc(100% - 4rem);
    }
  }
</style>